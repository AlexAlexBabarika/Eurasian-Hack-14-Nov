# Any OpenAI-compatible chat-completions API. Leave LLM_API_KEY empty to run without an LLM
# (keyword heuristics for policy claims, templates for verdict text).
LLM_API_KEY=
# Default is OpenRouter. Others: https://api.openai.com/v1, https://api.mistral.ai/v1,
# https://api.groq.com/openai/v1, http://localhost:11434/v1 (Ollama), ...
LLM_BASE_URL=https://openrouter.ai/api/v1
# Model ids as the provider names them. The model must support forced tool calls.
MODEL_FAST=anthropic/claude-sonnet-4.5
MODEL_STRONG=anthropic/claude-sonnet-4.5
# live | cached
DEMO_MODE=live
# optional, avoids GitHub rate limits
GITHUB_TOKEN=
