# Copy to .env (repo root). Read by api/app/llm.py via python-dotenv and by docker compose.
# Everything is optional: with no values set the pipeline runs end to end on heuristics.
# Variables already set in the shell win over this file.

# --- LLM (any OpenAI-compatible chat-completions API) ---
# Leave empty to run without an LLM (keyword heuristics for policy claims,
# templates for verdict text).
LLM_API_KEY=
# Default is OpenRouter. Others: https://api.openai.com/v1, https://api.mistral.ai/v1,
# https://api.groq.com/openai/v1, http://localhost:11434/v1 (Ollama), ...
LLM_BASE_URL=https://openrouter.ai/api/v1
# Model id as the provider names it. The model must support forced tool calls.
MODEL_FAST=anthropic/claude-sonnet-4.5
# Read by llm.py but no pipeline step uses it yet; falls back to MODEL_FAST.
MODEL_STRONG=anthropic/claude-sonnet-4.5
# Alternative to LLM_API_KEY: if only this is set, Anthropic's OpenAI-compatible
# endpoint is used and LLM_BASE_URL / MODEL_FAST default to Anthropic values.
# ANTHROPIC_API_KEY=

# --- Ingest ---
# Optional, used when cloning github.com repos; avoids rate limits.
GITHUB_TOKEN=

# --- API runtime ---
# live | cached. cached replays a finished audit with the same three URLs.
# `make demo` sets this to cached for you.
DEMO_MODE=live
# 1 accepts non-http(s) inputs such as local paths; keep 0 for anything public.
# `make api` / `make dev` ignore this line: pass it in the shell instead
# (ALLOW_LOCAL_INPUTS=1 make dev).
ALLOW_LOCAL_INPUTS=0
# 1 when strangers can reach the API: refuses local paths and private/local URLs.
# Leave empty for the localhost demo.
PUBLIC_MODE=
# Comma-separated CORS origins for the web app, no spaces.
# WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Web ---
# The Next.js app does not read this file. Its only variable, NEXT_PUBLIC_API_URL
# (default http://localhost:8000), lives in web/.env.local; see web/.env.example.
